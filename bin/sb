#!/usr/bin/env bash

################## https://github.com/mkropat/sh-realpath #####################

set -euo pipefail
trap "echo 'error: Script failed: see failed command above'" ERR

SCRIPT_PATH=$(command realpath "${BASH_SOURCE[0]}")
SCRIPT_DIR=$(dirname "$SCRIPT_PATH")
SCRIPT_PARENT=$(dirname "$SCRIPT_DIR")
build_command="${SB_BUILD_COMMAND:-shards}"

cr_target=""

for arg in "$@"; do
    case "$arg" in
        --target=*) cr_target=${arg#--target=} ;;
    esac
done

if [[ -n "$cr_target" ]]; then
    # For use hash map, BASH 4.0 is requried.
    declare -A mapping

    mapping["x86_64-linux-musl"]="x86_64-linux-musl x86_64-linux-musl"
    mapping["amd64"]="x86_64-linux-musl x86_64-linux-musl"

    mapping["aarch64-linux-musl"]="aarch64-linux-musl aarch64-linux-musl"
    mapping["arm64"]="aarch64-linux-musl aarch64-linux-musl"

    mapping["x86_64-darwin"]="x86_64-macos-none x86_64-sonoma"
    mapping["amd64-mac"]="x86_64-macos-none x86_64-sonoma"

    mapping["aarch64-darwin"]="aarch64-macos-none aarch64-sonoma"
    mapping["arm64-mac"]="aarch64-macos-none aarch64-sonoma"

    read -r targetname libname <<< "${mapping[$cr_target]}"

    build_args=()

    for arg in "$@"; do
        case "$arg" in
            --cross-compile|--static|--progress) ;;
            --target=*) build_args+=("--target=$targetname") ;;
            *) build_args+=("$arg") ;;
        esac
    done

    if [[ "$targetname" =~ -macos-none ]]; then
        build_args+=("-Duse_libiconv")
    else
        build_args+=("--static")
    fi

    build_args+=("--cross-compile")

    if [[ "$targetname" =~ -linux-musl$ ]]; then
        xml2_extra=" -llzma"
    else
        xml2_extra=""
    fi

    tmpfile="$(mktemp -d)/$$"

    "$build_command" build "${build_args[@]}" |tee "$tmpfile"

    if cc_output=$(cat "$tmpfile" |grep '^cc '); then
        lib_path="${SCRIPT_PARENT}/prebuilt_libs/${libname}"

        printf '\n'
        echo "$cc_output" |
            sed "s#^cc#zig cc -target ${targetname}#" | # replace "cc" with "zig cc --target ???"
            sed '/^zig cc/s#-licuuc##g' |
            sed '/^zig cc/s#-licudata##g' |
            sed "/^zig cc/s#-L[^ ]*#-L${lib_path}#" | # Where to find static libraries.
            sed "/^zig cc/s#.*#& -lunwind#" |        # Add -lunwind is necessary for Crystal backtrace feature.
            sed "/^zig cc/s#-lxml2#-lxml2${xml2_extra}#" | # Alpine's static libxml2 needs liblzma.
            tee "$tmpfile" && bash "$tmpfile"
    else
        echo "$build_output"
    fi

else
    "$build_command" build "$@"
fi
