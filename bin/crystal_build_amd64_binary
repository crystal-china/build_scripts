#!/bin/bash

set -eu

tag_name=crystal_build_amd64_binary
tmpdir=$(mktemp -d)
docker_file="$tmpdir/Dockerfile"
trap 'rm -f -- "$docker_file"; rmdir -- "$tmpdir"' EXIT

cat <<'HEREDOC' > $docker_file
# -*- mode: dockerfile-ts; -*-

ARG alpine_mirror=mirrors.ustc.edu.cn

FROM crystallang/crystal:1-alpine AS official_release

ARG alpine_mirror
RUN sed -i "s/dl-cdn.alpinelinux.org/$alpine_mirror/g" /etc/apk/repositories

RUN apk add --no-cache gmp-static

WORKDIR /app

# 如果需要重新运行 shards install，取消注释，其目的是使后面的 RUN 命令 cache 失效
ARG FORCE_ARG

ARG flags="--stats --time"
ARG compile_time_flags="-Dstrict_multi_assign -Dno_number_autocast \
    -Duse_pcre2 -Dpreview_overload_order"
# 有关 linker 选项：-Wl 之后的所有选项，按照逗号分隔，全部会发送给 linker,
# 也就是 linux 下的 ld, 详细解释，看 ld --help
ARG link_flags="--link-flags=-Wl,-L/app --link-flags=-s --link-flags=-no-pie"

RUN --mount=type=cache,target=/root/.cache/shards \
    if [ -f shard.yml ]; then \
        shards install \
            --production \
            --ignore-crystal-version \
            --skip-postinstall \
            --skip-executables; \
    fi

# 使后面的 CMD 命令 cache 失效
ARG CACHEBUST_ARG

ARG SHARDS_TARGET

ARG CRYSTAL_ARGS=""

RUN --mount=type=cache,target=/root/.cache/crystal \
    shards build $SHARDS_TARGET --production \
    --static \
    $flags $compile_time_flags $link_flags \
    $CRYSTAL_ARGS
HEREDOC

cr_file=""

if [[ "${1:-}" == *.cr ]]; then
    [[ -f "$1" ]] || {
        printf 'Source file not found: %s\n' "$1" >&2
        exit 2
    }

    cr_file=$1

    sed -i \
        "s#shards build .* --production#crystal build \"$cr_file\"#" \
        "$docker_file"

    shift
fi

BUILD_ARGS=(
    --build-arg "CACHEBUST_ARG=$(date +%s%N)"
    --build-arg "SHARDS_TARGET=${SHARDS_TARGET:-}"
    -v "$PWD:/app"
    -t "$tag_name"
    -f "$docker_file"
)

build_flags_conf="$PWD/build_flags.conf"
if [ -s "$build_flags_conf" ]; then
    printf 'WARNING: Loading custom build arguments from %s\n' "$build_flags_conf" >&2
    BUILD_ARGS+=(
        --build-arg-file "$build_flags_conf"
    )
fi

crystal_args=()

while (( $# > 0 )); do
    case "$1" in
        -f)
            BUILD_ARGS+=(
                --build-arg "FORCE_ARG=$(date +%s%N)"
            )
            ;;
        -ff)
            BUILD_ARGS+=(
                --no-cache
                --pull=always
                --progress=plain
            )
            ;;
        *)
            crystal_args+=("$1")
            ;;
    esac

    shift
done

if [[ -n "$cr_file" ]]; then
    output=$(basename -- "$cr_file" .cr)

    for ((i=0; i<${#crystal_args[@]}; i++)); do
        if [[ "${crystal_args[i]}" == "-o" ]]; then
            output="${crystal_args[i+1]:-}"
            break
        fi
    done

    if [[ -d "$output" ]]; then
        printf "Error: can't use \`%s\` as output filename because it's a directory\n" "$output" >&2
        exit 2
    fi
fi

BUILD_ARGS+=(
    --build-arg "CRYSTAL_ARGS=${crystal_args[*]}"
)


# 如果使用 podman, 已经帮你处理了 -v $PWD:/app 时会遇到的权限的问题，爽歪歪
podman build "${BUILD_ARGS[@]}"

# podman run -v $PWD:/app $tag_name "${@}"
