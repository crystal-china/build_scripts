#!/bin/bash

# 检测 all supported platform for alpine
# podman run --rm mplatform/mquery alpine:latest
# ALLOWED_ARCHS=("linux/arm64/v8" "linux/arm/v7" "linux/arm/v6" "linux/amd64" "linux/386")
ALLOWED_ARCHS=("linux/arm64/v8" "linux/amd64")

platform=${PLATFORM-linux/amd64}

for arch in "${ALLOWED_ARCHS[@]}"; do
    if [ "$platform" == "$arch" ]; then
        match_found=true
        break # 找到匹配项，退出循环
    fi
done

if [ -z "$match_found" ]; then
    echo "Error: invalid platform '$platform'。"
    echo "Use one of following:"
    printf "  - %s\n" "${ALLOWED_ARCHS[@]}" # 使用 printf 更清晰地打印列表
    exit 1 # 退出并返回错误码
fi

declare -A target_map=(
    ["linux/arm64/v8"]="aarch64-unknown-linux-musl"
     ["linux/amd64"]="x86_64-unknown-linux-musl"
)

set -eux

force="${1:-}"

if [[ "$force" == "-f" || "$force" == "-ff" ]]; then
    shift
else
    force=""
fi

tag_name="build_rust_${platform//\//_}_binary"
tmpdir=$(mktemp -d)
docker_file="$tmpdir/Dockerfile"
trap 'rm -f -- "$docker_file"; rmdir -- "$tmpdir"' EXIT

if ! podman image exists "localhost/$tag_name:latest" || [[ -n "$force" ]]; then
    cat <<HEREDOC > $docker_file
ARG alpine_version=3.23
ARG alpine_mirror=mirrors.ustc.edu.cn

# FROM rust:1-alpine
FROM --platform=\$BUILDPLATFORM alpine:\$alpine_version

ARG FORCE_ARG

ARG alpine_mirror
RUN sed -i "s/dl-cdn.alpinelinux.org/\$alpine_mirror/g" /etc/apk/repositories

RUN set -eux; \
    apk add \
    --update \
    gc-static pcre2-static libevent-static \
    sqlite-static openssl-libs-static \
    yaml-static \
    zlib-static \
    libxml2-static \
    gmp-static \
    xz-static \
    g++ make automake libtool autoconf \
    git curl \
    zig \
    ;

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable

ENV PATH="/root/.cargo/bin:\${PATH}"

RUN rustup target add aarch64-unknown-linux-musl

RUN cargo install cargo-zigbuild --locked

WORKDIR /app

# 允许 override 这个变量，AMD64 平台下默认是 12(2^^14，4K), 但是树莓派下是 16 (64K)
#  具体大小可以通过 getconf PAGE_SIZE 获取
ARG JEMALLOC_SYS_WITH_LG_PAGE=12
# 确保运行时也继承
ENV JEMALLOC_SYS_WITH_LG_PAGE=\$JEMALLOC_SYS_WITH_LG_PAGE

CMD cargo zigbuild --release --target ${target_map["$platform"]}
HEREDOC

    BUILD_ARGS=(
        -t "$tag_name"
        -f "$docker_file"
    )

    case "$force" in
        -f)
            BUILD_ARGS+=(
                --build-arg "FORCE_ARG=$(date +%s%N)"
            )
            ;;
        -ff)
            BUILD_ARGS+=(
                --no-cache
                --pull=always
                --progress=plain
            )
            ;;
    esac

    # 调试输出，使用 --progress=plain --no-cache
    podman buildx build "${BUILD_ARGS[@]}" .
fi

podman run -v $PWD:/app $tag_name "$@"
